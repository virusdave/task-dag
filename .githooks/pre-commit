#!/usr/bin/env bash
# Pre-commit gate for the automation repo.
#
# Currently the only gated area is helios/. We do **not** run a real
# browser (playwright is too heavy for a pre-commit hook in this
# environment) — instead we:
#
#   1. Compile the server tree (tsc -p tsconfig.server.json) — this is
#      the same artifact prod runs, so it's also our server typecheck.
#   2. Typecheck the client tree (tsc --noEmit -p tsconfig.client.json).
#   3. Boot the Fastify server in-process and exercise the SPA shell +
#      hashed-asset endpoints via server.inject(), to catch the class
#      of regression where the SPA root page renders blank (see
#      helios/scripts/smoke-server.ts).
#
# Skip with `git commit --no-verify` only if you understand what you're
# bypassing; the repo AGENTS.md explicitly forbids agents from using
# --no-verify.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Find staged files that touch helios/ (excluding deletions).
mapfile -t helios_changes < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '^helios/' || true)

if [[ ${#helios_changes[@]} -eq 0 ]]; then
  exit 0
fi

echo "[pre-commit] helios changes detected (${#helios_changes[@]} file(s)); running gate…"

cd "$repo_root/helios"

# Resolve binaries from the local node_modules so the hook works on
# systems that don't have tsc / tsx on $PATH.
TSC="./node_modules/.bin/tsc"
TSX="./node_modules/.bin/tsx"

for bin in "$TSC" "$TSX"; do
  if [[ ! -x "$bin" ]]; then
    echo "[pre-commit] FAIL: required binary $bin not found." >&2
    echo "[pre-commit]  → run \`npm install\` inside helios/ first." >&2
    exit 1
  fi
done

echo "[pre-commit] 1/3 compiling server (tsc -p tsconfig.server.json)…"
# This is a full typecheck *and* the build the smoke test depends on,
# in one pass. The server tsconfig excludes tests/vitest, so we don't
# need vitest installed locally to get a clean typecheck.
"$TSC" -p tsconfig.server.json
# `tsc -p tsconfig.server.json` alone doesn't copy the non-TS
# scheduling stub the worker needs. Mirror the npm script so a
# smoke-time import doesn't trip on a missing file:
mkdir -p dist/server/worker/scheduling
cp src/worker/scheduling/extractConstraints.js dist/server/worker/scheduling/extractConstraints.js

echo "[pre-commit] 2/3 typechecking client (tsc -p tsconfig.client.json --noEmit)…"
# Strict client typecheck — matches CI. tsconfig.client.json excludes
# *.test.ts/tsx and the node-only shared/ modules, so this checks only
# the browser bundle's sources.
"$TSC" -p tsconfig.client.json --noEmit

echo "[pre-commit] 3/3 booting server + smoke-checking SPA shell and assets…"
"$TSX" scripts/smoke-server.ts

echo "[pre-commit] OK."
