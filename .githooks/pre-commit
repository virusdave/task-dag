#!/usr/bin/env bash
# Pre-commit gate for the automation repo. This is a *fast/targeted*
# local gate (see AGENTS.md "Dev-loop checks"): three instant repo-wide
# scanners on every commit, plus package-scoped checks only for the
# package(s) the commit actually touches. The heavy helios checks (the
# full unit-test suite and the production client bundle) are CI-owned and
# deliberately NOT run here.
#
# NOTE: branch protection is unavailable on this repo, so CI is advisory
# (non-blocking) and THIS HOOK is the only enforcement that runs before
# code reaches master and is deployed. Do not weaken a gate here without
# an equal-or-stronger replacement (AGENTS.md "Interim CI-enforcement
# exception").
#
# helios/: we do **not** run a real browser (playwright is too heavy for
# a pre-commit hook in this environment) — instead we:
#   1. Compile the server tree (tsc -p tsconfig.server.json) — this is
#      the same artifact prod runs, so it's also our server typecheck.
#   2. Typecheck the client tree (tsc --noEmit -p tsconfig.client.json).
#   3. Boot the Fastify server in-process and exercise the SPA shell +
#      hashed-asset endpoints via server.inject(), to catch the class
#      of regression where the SPA root page renders blank (see
#      helios/scripts/smoke-server.ts).
# ads/google/: a fast typecheck-only package.
#
# The repo AGENTS.md and canon explicitly forbid agents from using
# `git commit --no-verify` to bypass this gate.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# All three repo-wide scanners are cheap (<1s each, pure git/bash), so
# they run on *every* commit regardless of which area changed — a
# weakened gate anywhere is a master breakage. They mirror the CI
# `scanners` job (CI is advisory here: branch protection is unavailable
# on this repo, so the hook is the only pre-master enforcement — see
# AGENTS.md "Dev-loop checks" / "Interim CI-enforcement exception").

# Repo-wide explicit-`any` scanner (automation#49 Phase D.9): the
# grep-gate that enforces canon's "no first-party any".
echo "[pre-commit] scanning for first-party \`any\`…"
bash "$repo_root/scripts/scan-explicit-any.sh"

# Repo-wide disabled-gate scanner (automation#49 Phase D.10).
echo "[pre-commit] scanning for disabled/weakened gates…"
bash "$repo_root/scripts/scan-disabled-gates.sh"

# Repo-wide test-resource scanner (automation#49 Phase D.11): flags any
# committed test that reaches a prod serving resource (ambient-env
# fallback, non-loopback DB/broker URL, real credential path).
echo "[pre-commit] scanning tests for prod-resource access…"
bash "$repo_root/scripts/scan-test-resources.sh"

# --- ads/google (package-scoped) -------------------------------------
# Fast (~6s) typecheck-only package. Runs only when staged files touch
# ads/google/. CI is advisory here (no branch protection), so we close
# the pre-master window for this package too. The full vitest/build are
# helios-only; ads/google has no heavy check.
mapfile -t ads_google_changes < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '^ads/google/' || true)
if [[ ${#ads_google_changes[@]} -gt 0 ]]; then
  echo "[pre-commit] ads/google changes detected (${#ads_google_changes[@]} file(s)); typechecking…"
  ADS_TSC="$repo_root/ads/google/node_modules/.bin/tsc"
  if [[ ! -x "$ADS_TSC" ]]; then
    echo "[pre-commit] FAIL: $ADS_TSC not found." >&2
    echo "[pre-commit]  → run \`npm install\` inside ads/google/ first." >&2
    exit 1
  fi
  ( cd "$repo_root/ads/google" && "$ADS_TSC" -p tsconfig.json --noEmit )
fi

# Find staged files that touch helios/ (excluding deletions).
mapfile -t helios_changes < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '^helios/' || true)

if [[ ${#helios_changes[@]} -eq 0 ]]; then
  exit 0
fi

echo "[pre-commit] helios changes detected (${#helios_changes[@]} file(s)); running gate…"

cd "$repo_root/helios"

# Resolve binaries from the local node_modules so the hook works on
# systems that don't have tsc / tsx on $PATH.
TSC="./node_modules/.bin/tsc"
TSX="./node_modules/.bin/tsx"

for bin in "$TSC" "$TSX"; do
  if [[ ! -x "$bin" ]]; then
    echo "[pre-commit] FAIL: required binary $bin not found." >&2
    echo "[pre-commit]  → run \`npm install\` inside helios/ first." >&2
    exit 1
  fi
done

echo "[pre-commit] 1/3 compiling server (tsc -p tsconfig.server.json)…"
# This is a full typecheck *and* the build the smoke test depends on,
# in one pass. The server tsconfig excludes tests/vitest, so we don't
# need vitest installed locally to get a clean typecheck.
"$TSC" -p tsconfig.server.json
# `tsc -p tsconfig.server.json` alone doesn't copy the non-TS
# scheduling stub the worker needs. Mirror the npm script so a
# smoke-time import doesn't trip on a missing file:
mkdir -p dist/server/worker/scheduling
cp src/worker/scheduling/extractConstraints.js dist/server/worker/scheduling/extractConstraints.js

echo "[pre-commit] 2/3 typechecking client (tsc -p tsconfig.client.json --noEmit)…"
# Strict client typecheck — matches CI. tsconfig.client.json excludes
# *.test.ts/tsx and the node-only shared/ modules, so this checks only
# the browser bundle's sources.
"$TSC" -p tsconfig.client.json --noEmit

echo "[pre-commit] 3/3 booting server + smoke-checking SPA shell and assets…"
"$TSX" scripts/smoke-server.ts

echo "[pre-commit] OK."
