# Dependencies
node_modules/

# helios package-lock is regenerated by helios-prep on every host deploy
# (`npm install`, not `npm ci`) — tracking it caused repeat checkout
# conflicts when the on-host generated file collides with a tracked copy.
helios/package-lock.json

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Build outputs
dist/
*.tsbuildinfo

# Logs
*.log

# Backup files
*.backup
*.bak

# Secrets / local env (keep .env.example tracked)
.env
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo


# Google Ads bundle outputs are per-run artifacts and are written to
# the host's persistent data dir (symlinked over the in-tree path via
# the gads-prep deploy script). Committing them caused gads-prep to
# fail every hour with "untracked working tree files would be
# overwritten by checkout" because the tracked paths collided with
# the symlinked data dir's live state. Always emit, never commit.
ads/google/outputs/
