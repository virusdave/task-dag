#!/bin/bash
# Git commit-msg hook to prevent tombstone commit misuse
# 
# This hook prevents agents from creating empty "tombstone" commits
# for active work. Tombstones are ONLY for retroactive linking of
# historical commits that predate the task-dag system.
#
# To install: cp .github/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# To bypass (for legitimate retroactive work): ALLOW_TOMBSTONE=1 git commit ...

# Check if this is being bypassed for legitimate retroactive work
if [ "${ALLOW_TOMBSTONE:-0}" = "1" ]; then
    echo "Bypassing tombstone check (ALLOW_TOMBSTONE=1)"
    exit 0
fi

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check if the commit is empty (no changes)
if git diff --cached --quiet; then
    # Empty commit detected - check if it looks like a tombstone
    if echo "$COMMIT_MSG" | grep -qiE "tombstone|retroactive|Task completion tombstone"; then
        cat >&2 <<EOF

ERROR: Empty "tombstone" commit detected.

For normal task work, you should:
  1. Make your code changes
  2. Commit them normally: git commit -m "Your implementation"
  3. Link to task: task-dag complete <task-sha>

Empty "tombstone" commits are ONLY for retroactive linking of historical
work that was completed before the task-dag system existed.

If you are actively implementing a task right now, this is the WRONG approach.
Use 'task-dag complete' with real implementation commits instead.

To bypass this check for legitimate retroactive work:
  ALLOW_TOMBSTONE=1 git commit ...

See AGENTS.md for the correct Git-DAG task workflow.

EOF
        exit 1
    fi
    
    # Also warn about any empty commit, not just obvious tombstones
    if echo "$COMMIT_MSG" | grep -qiE "Task:|complete|link|track"; then
        cat >&2 <<EOF

WARNING: Empty commit with task-related message detected.

This commit has no file changes but mentions task tracking.
Are you trying to create a tombstone commit?

For normal work: Use 'task-dag complete' to link real implementation commits.
Tombstones are only for retroactive linking of historical work.

Press Ctrl-C to abort, or Enter to continue anyway...
EOF
        read -r
    fi
fi

exit 0
