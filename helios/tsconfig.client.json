{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/client",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./tsconfig.client.tsbuildinfo"
  },
  "include": [
    "src/client/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*",
    "src/shared/config/runtimeEnv.ts",
    "src/shared/util/hash.ts"
  ]
}
