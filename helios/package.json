{
  "name": "helios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server,worker -c blue,green,yellow \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate": "tsx scripts/runMigrations.ts",
    "db:status": "tsx scripts/runMigrations.ts --status",
    "user:provision": "tsx scripts/provisionUser.ts",
    "import:review": "tsx scripts/importReviewPacket.ts",
    "review:bronx-midtown-pricing": "tsx scripts/runBronxMidtownPricingReviewService.ts",
    "smoke:workflow": "tsx scripts/smokeWorkflow.ts"
  },
  "dependencies": {
    "@daypilot/daypilot-lite-react": "^5.6.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "fastify": "^5.6.1",
    "google-auth-library": "^10.5.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "vitest": "^4.0.7"
  }
}
