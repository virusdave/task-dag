    "react-router-dom": "^7.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
