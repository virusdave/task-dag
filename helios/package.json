{
  "name": "@freshly-baked/helios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json && npm run copy:non-ts-server-assets",
    "copy:non-ts-server-assets": "mkdir -p dist/server/worker/scheduling && cp src/worker/scheduling/extractConstraints.js dist/server/worker/scheduling/extractConstraints.js",
    "build:client": "vite build",
    "dev:server": "tsc -p tsconfig.server.json --watch",
    "dev:client": "vite",
    "start:server": "node dist/server/main.js",
    "start:worker": "node dist/worker/main.js"
  },
  "dependencies": {
    "@daypilot/daypilot-lite-react": "^5.6.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.0.2",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "arcsecond": "^5.0.0",
    "dagre": "^0.8.5",
    "fastify": "^5.2.0",
    "google-auth-library": "^10.4.0",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.6"
  }
}
