#!/usr/bin/env bash
# Compatibility launcher for prepared workspaces and packages that still
# resolve the historical scripts/task-dag path. Task semantics live only in
# the installed Rust v2 runtime.
set -euo pipefail

if command -v task-dag-v2 >/dev/null 2>&1; then
  exec task-dag-v2 "$@"
fi

echo "task-dag: the Rust v2 runtime (task-dag-v2) is not installed" >&2
exit 127
