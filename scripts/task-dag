#!/usr/bin/env bash

set -euo pipefail

readonly TASKDAG_V2_BIN="${TASKDAG_V2_BIN:-/run/current-system/sw/bin/task-dag-v2}"

if [[ ! -x "$TASKDAG_V2_BIN" ]]; then
    printf 'task-dag: canonical Rust v2 runtime is unavailable at %s\n' "$TASKDAG_V2_BIN" >&2
    printf 'task-dag: deploy the current task-dag system package before retrying; legacy v1 execution is disabled\n' >&2
    exit 127
fi

exec "$TASKDAG_V2_BIN" "$@"
