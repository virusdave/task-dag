#!/usr/bin/env bash
# Fix mss-one-offs slots directory permissions
# This script needs to be run with sudo or as root

set -euo pipefail

SLOTS_DIR="/var/lib/mss-one-offs/slots"

echo "Fixing mss-one-offs slots directory permissions..."
echo "Current permissions:"
ls -ld "${SLOTS_DIR}"

echo ""
echo "Setting group-writable with setgid..."
chmod 2770 "${SLOTS_DIR}"

echo "New permissions:"
ls -ld "${SLOTS_DIR}"

echo ""
echo "✅ Fix applied successfully!"
echo ""
echo "Users in the mss-one-offs group can now upload files without sudo."
