#!/usr/bin/env bash
# Upload files to mss-one-offs server
# Usage: upload-to-mss <file> [note] [ttl-seconds]

set -euo pipefail

usage() {
  cat <<'EOF'
Upload files to mss-one-offs server

Usage: upload-to-mss <file> [note] [ttl-seconds]

Arguments:
  file          Path to the file to upload (served as index.html)
  note          Optional free-text note (default: "File uploaded by <user>")
  ttl-seconds   Optional lifetime in seconds (default: 86400 = 24 hours)

Examples:
  upload-to-mss report.html
  upload-to-mss report.html "Phase D Review"
  upload-to-mss report.html "Test upload" 3600
EOF
}

# Innocuous --help / -h: print usage and exit 0 before any effect (no upload,
# no slot claim, no file writes) — canon: rules/QUALITY_GATES.md "Every tool
# must have an innocuous --help". Handled first, ahead of all other work.
for _arg in "$@"; do
  case "$_arg" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

HTML_FILE="$1"
NOTE="${2:-File uploaded by $(whoami)}"
TTL_SECONDS="${3:-86400}"  # 24 hours default

if [[ ! -f "${HTML_FILE}" ]]; then
  echo "Error: File not found: ${HTML_FILE}"
  exit 1
fi

# Generate upload ID
UPLOAD_ID="upload-$(date +%Y%m%d-%H%M%S)-$(openssl rand -hex 4)"
INCOMING_DIR="/var/lib/mss-one-offs/incoming/${UPLOAD_ID}"

echo "Uploading: ${HTML_FILE}"
echo "Upload ID: ${UPLOAD_ID}"
echo ""

# Create directory and copy file
mkdir -p "${INCOMING_DIR}"
cp "${HTML_FILE}" "${INCOMING_DIR}/index.html"

echo "✓ File copied to incoming directory"

# Claim slot via control socket
echo "✓ Claiming slot..."

RESPONSE=$(curl --unix-socket /run/mss-one-offs/control.sock \
  -sS -X POST http://localhost/v1/slots \
  -H 'content-type: application/json' \
  -d "{\"uploadId\":\"${UPLOAD_ID}\",\"ttlSeconds\":${TTL_SECONDS},\"requestedBy\":\"$(whoami)\",\"note\":\"${NOTE}\"}")

# Check for error
if echo "${RESPONSE}" | jq -e '.error' >/dev/null 2>&1; then
  echo ""
  echo "❌ Upload failed!"
  echo "Error: $(echo "${RESPONSE}" | jq -r '.error')"
  echo ""
  echo "This likely means the permissions fix hasn't been applied."
  echo "Run: sudo scripts/fix-mss-one-offs-permissions"
  exit 1
fi

# Extract URL
URL=$(echo "${RESPONSE}" | jq -r '.url')

echo ""
echo "✅ Upload successful!"
echo ""
echo "URL: ${URL}"
echo "TTL: ${TTL_SECONDS} seconds ($(( TTL_SECONDS / 3600 )) hours)"
echo ""
