{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freshlybaked.us/lp/schemas/assets.v1.schema.json",
  "title": "Landing-page asset/variant pool (assets.json) v1",
  "description": "Per-slot variant pool with 'existing > generated' precedence and per-variant approval status (parent EPIC_PLAN §5). Only approved variants may appear in a published bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "variants"],
  "properties": {
    "schema": { "const": "freshlybaked.lp.assets.v1" },
    "bundle_id": {
      "type": "string",
      "pattern": "^lpb_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}_[0-9a-f]{6}$"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/variant" }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "slot", "source", "approval_status"],
      "properties": {
        "variant_id": { "type": "string", "minLength": 1, "description": "Referenced by policy.json slots and the kill-list." },
        "slot": { "type": "string", "pattern": "^X[1-9][0-9]*$" },
        "family": { "type": "string", "description": "Family this variant belongs to (optional for shared variants)." },
        "source": {
          "type": "string",
          "enum": ["existing", "generated"],
          "description": "Precedence on tie: existing wins over generated (parent §5)."
        },
        "approval_status": {
          "type": "string",
          "enum": ["approved", "pending", "rejected"],
          "description": "A published bundle must contain only 'approved' variants (fail-closed otherwise)."
        },
        "approval_id": { "type": "string", "description": "Provenance: the asset/legal approval id." },
        "asset_refs": {
          "type": "array",
          "description": "Content-addressed blob references that make up this variant.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {
              "sha256": { "$ref": "#/definitions/sha256" },
              "role": { "type": "string", "description": "e.g. 'image', 'headline', 'body', 'cta'." },
              "media_type": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
