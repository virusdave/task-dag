{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freshlybaked.us/lp/schemas/bundle-manifest.v1.schema.json",
  "title": "Landing-page bundle manifest (manifest.json) v1",
  "description": "Signed index that binds bundle.json/policy.json/assets.json to their checksums and provenance, plus a minimum renderer version (parent EPIC_PLAN §5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "min_renderer_version",
    "automation_git_sha",
    "generated_from",
    "files",
    "signature"
  ],
  "properties": {
    "schema": { "const": "freshlybaked.lp.bundle-manifest.v1" },
    "bundle_id": { "$ref": "#/definitions/bundle_id" },
    "min_renderer_version": {
      "type": "string",
      "minLength": 1,
      "description": "Semver constraint the running mss renderer must satisfy, e.g. 'mss-lp-runtime>=0.4.0'. Validation is fail-closed if unmet."
    },
    "automation_git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version_id"],
      "properties": {
        "cluster_sweep_run_id": { "type": "integer", "minimum": 1 },
        "asset_approval_snapshot_id": { "type": "integer", "minimum": 1 },
        "policy_version_id": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "policy", "assets"],
      "properties": {
        "bundle": { "$ref": "#/definitions/file_ref" },
        "policy": { "$ref": "#/definitions/file_ref" },
        "assets": { "$ref": "#/definitions/file_ref" }
      }
    },
    "signature": { "$ref": "#/definitions/signature", "description": "ed25519 signature over the canonicalized manifest (excluding this field)." }
  },
  "definitions": {
    "bundle_id": {
      "type": "string",
      "pattern": "^lpb_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}_[0-9a-f]{6}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9+/=_-]+$" },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the bundle directory. Must NOT be absolute, contain '..', or be a symlink (validated by the publisher and the loader).",
          "pattern": "^[^/][^\\\\]*$"
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
