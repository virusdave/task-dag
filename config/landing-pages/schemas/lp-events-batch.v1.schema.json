{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freshlybaked.us/lp/schemas/lp-events-batch.v1.schema.json",
  "title": "Landing-page events batch (POST /v1/lp-events/batch body) v1",
  "description": "Append-only impression/redirect/assignment/conversion events shipped by the mss runtime in ~15-min compressed batches for one Helios bulk insert (parent EPIC_PLAN §8). Delivery is at-least-once; exactly-once is analytic via event_id. mss render path does ZERO DB; cost scales with batch count, not impression count.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "replica_id", "sent_at", "events"],
  "properties": {
    "schema": { "const": "freshlybaked.lp.events-batch.v1" },
    "replica_id": { "type": "string", "minLength": 1 },
    "sent_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/event" }
    }
  },
  "definitions": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "event_ts", "replica_id", "bundle_id", "policy_id", "site"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1, "description": "Per-render idempotency key (analytic exactly-once)." },
        "event_type": {
          "type": "string",
          "enum": ["lp_impression", "lp_redirect", "lp_assignment", "lp_conversion"]
        },
        "event_ts": { "type": "string", "format": "date-time" },
        "replica_id": { "type": "string", "minLength": 1 },
        "bundle_id": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_rule_id": { "type": "string" },
        "experiment_id": { "type": "string" },
        "assignment_id": {
          "type": "string",
          "description": "HMAC-bound to bundle_id|policy_rule_id|slot|variant|bucket so client tampering can't forge attribution (parent §9)."
        },
        "assignment_key_type": {
          "type": "string",
          "enum": ["gclid", "gbraid", "wbraid", "cookie", "session", "default"]
        },
        "branch_id": { "type": "string", "description": "The chosen NUM/branch embedded in the URL." },
        "selected_variants": {
          "type": "object",
          "description": "The served variant per slot. Keyed by slot id.",
          "additionalProperties": { "type": "string" }
        },
        "counterfactual_variants": {
          "type": "object",
          "description": "What the greedy/exploit policy would have served per slot (for unbiased lift). Keyed by slot id.",
          "additionalProperties": { "type": "string" }
        },
        "candidate_weights": {
          "type": "object",
          "description": "Per-slot candidate set with weights, for propensity. Keyed by slot id.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant_id", "weight"],
              "properties": {
                "variant_id": { "type": "string" },
                "weight": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "served_probability_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Probability (basis points) the served variant set was chosen — the propensity for unbiased off-policy estimates."
        },
        "bucket_bps": { "type": "integer", "minimum": 0, "maximum": 9999, "description": "HMAC(experiment_salt, assignment_key) % 10000." },
        "gclid_hash": { "type": "string", "description": "Salted hash of the Google click id; raw id never used as a grouping/dedup key." },
        "site": { "type": "string", "minLength": 1 },
        "family": { "type": "string" },
        "cluster_slug": { "type": "string" },
        "traffic_flags": {
          "type": "array",
          "items": { "type": "string", "examples": ["paid_google", "bot_suspected"] }
        }
      }
    }
  }
}
