# Google Ads API Credentials
GADS_CLIENT_ID=your_client_id
GADS_CLIENT_SECRET=your_client_secret
GADS_REFRESH_TOKEN=your_refresh_token
GADS_DEVELOPER_TOKEN=your_developer_token
GADS_CUSTOMER_ID=123-456-7890

# Helios Database Connection
HELIOS_HOST=localhost
HELIOS_PORT=5432
HELIOS_DATABASE=helios
HELIOS_USER=helios
HELIOS_PASSWORD=your_password
HELIOS_SSL=true

# LLM Endpoints
LLM_ENDPOINT_BASE=https://api.example.com/v1
LLM_API_KEY=your_llm_api_key

# External Services
MSS_ONE_OFFS_PATH=/path/to/mss-one-offs
LITALERTS_ENDPOINT=https://litalerts.example.com/api/alerts
